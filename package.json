{
  "name": "symptopage-windows",
  "productName": "SymptoPage",
  "version": "0.5.0",
  "private": true,
  "description": "A private, local symptom journal and appointment companion. English and Polish.",
  "author": "SymptoPage",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "playwright test",
    "build:win": "electron-builder --win nsis portable zip --x64 --publish never",
    "build:dir": "electron-builder --dir --publish never",
    "postinstall": "node node_modules/electron/install.js",
    "export:i18n": "node scripts/export-i18n.mjs"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "@playwright/test": "1.63.0"
  },
  "build": {
    "appId": "app.symptopage.windows",
    "productName": "SymptoPage",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**",
      "core/**",
      "ui/**",
      "assets/**",
      "package.json",
      "NOTICE.md",
      "LICENSE_STATUS.md"
    ],
    "win": {
      "target": [
        "nsis",
        "portable",
        "zip"
      ],
      "icon": "assets/icon.ico",
      "signExecutable": false,
      "artifactName": "SymptoPage-${version}-Windows-x64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "SymptoPage-${version}-Windows-Setup.${ext}"
    },
    "portable": {
      "artifactName": "SymptoPage-${version}-Windows-Portable.${ext}"
    },
    "extraResources": [
      {
        "from": "NOTICE.md",
        "to": "NOTICE.md"
      }
    ]
  },
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12.0"
  }
}
